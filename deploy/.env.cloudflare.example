# Copy to deploy/.env.cloudflare on the hosting server; never commit the filled file.
# Use separate random hexadecimal passwords so MYSQL_PASSWORD is URL-safe.
# Generate each secret independently, for example: openssl rand -hex 48
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX_ROOT_PASSWORD
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_HEX_APPLICATION_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS

# Exact HTTPS origin, without a path. Must match the tunnel's published hostname.
APP_URL=https://REPLACE_WITH_PUBLIC_HOSTNAME
APPROVED_EMAIL_DOMAINS=REPLACE_WITH_INSTITUTIONAL_EMAIL_DOMAIN

# Use a real SMTP relay; the local Mailpit inbox is not part of this deployment.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=FixMyCampus <REPLACE_WITH_VERIFIED_SENDER>

# Obtain from the Cloudflare dashboard for the named tunnel. Do not use an API key.
TUNNEL_TOKEN=REPLACE_WITH_TUNNEL_CONNECTOR_TOKEN
