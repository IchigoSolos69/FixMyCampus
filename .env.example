# Local development only. Never deploy these example credentials.
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
DATABASE_URL=mysql://campus:campus@127.0.0.1:3306/fixmycampus
# For managed MySQL, paste the provider CA PEM (real newlines or literal \n).
# Never disable certificate or hostname verification for a public database.
DATABASE_SSL_CA=
JWT_SECRET=local-development-only-change-this-secret-before-deployment-2026
APPROVED_EMAIL_DOMAINS=campus.test
UPLOADS_DIR=../../uploads
STORAGE_DRIVER=local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=FixMyCampus <noreply@campus.test>
SMTP_USER=
SMTP_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=
# Integration tests require a separate, disposable database with "test" in its name.
# TEST_DATABASE_URL=mysql://campus:campus@127.0.0.1:3306/fixmycampus_test
# MYSQL_ROOT_PASSWORD is required by compose.yml; use a strong local secret.
MYSQL_ROOT_PASSWORD=replace-this-local-mysql-root-password
# One-time production administrator bootstrap. Leave unset during normal operation.
# BOOTSTRAP_ADMIN_NAME=Campus Administrator
# BOOTSTRAP_ADMIN_EMAIL=administrator@yourinstitution.edu
# BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-strong-password
